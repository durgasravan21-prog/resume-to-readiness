# Database (PostgreSQL - Neon / Supabase)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/readiness"

# Auth.js / NextAuth v5
AUTH_SECRET="your_32_character_auth_secret_key_here"
AUTH_URL="http://localhost:3000"
ALLOWED_EMAIL_DOMAIN="nie.ac.in"

# Vercel Blob (Private resume storage)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_token_placeholder"

# Anthropic AI Claude 3.5 Sonnet
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# Inngest Background Jobs
INNGEST_EVENT_KEY="local"
INNGEST_SIGNING_KEY="local"

# Upstash Redis Rate Limiting
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase (Optional fallback client access)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-placeholder"
